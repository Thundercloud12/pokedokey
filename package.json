{
  "name": "football-gamer-monorepo",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm --workspace=@game/client run dev",
    "dev:server": "npm --workspace=@game/server run dev",
    "build:shared": "npm --workspace=@game/shared run build",
    "build:client": "npm --workspace=@game/client run build",
    "build:server": "npm --workspace=@game/server run build",
    "build": "npm run build:shared && npm run build:client",
    "start": "npm --workspace=@game/client run preview",
    "server": "npm --workspace=@game/server start",
    "start:server": "npm --workspace=@game/server start",
    "preview": "npm --workspace=@game/client run preview"
  }
}
